###############################################################
# This file contains the verb definitions for broot
#
# Some verbs here are examples and not enabled by default: you
#  need to uncomment them if you want to use them.
#
# Documentation at https://dystroy.org/broot/verbs/
###############################################################

verbs: [

    # Float the selected file as an always-on-top window via DMS' Floaty plugin.
    # `external` is an argv array so paths with spaces survive; {file} is the
    # absolute path, so "file://{file}" becomes file:///abs/path.
    {
        invocation: floaty
        key: ctrl-f
        external: [ "dms", "ipc", "call", "floaty", "floatFromUrl", "file://{file}" ]
        leave_broot: false
    }

    # You should customize this standard opening of text files.
    # If you edit text files in your terminal (vi, emacs, helix, eg.), then
    #  you'll find it convenient to change the 'key' from 'ctrl-e' to 'enter'.
    #
    # If $EDITOR isn't set on your computer, you should either set it using
    #  something similar to
    #    export EDITOR=/usr/local/bin/nvim
    #  or just replace it with your editor of choice in the 'execution'
    #  pattern.
    # If your editor is able to open a file on a specific line, use {line}
    #  so that you may jump directly at the right line from a preview or
    #  a content search.
    # Examples depending on your favourite editor:
    #    external: "nvim +{line} {file:space-separated}"
    #    external: "helix {file}:{line}"
    {
        invocation: edit
        shortcut: e
        key: enter
        apply_to: text_file
        external: "emacsclient -n +{line} {file:space-separated}"
        leave_broot: true
    }
    {
	invocation: "copy_path"
    	shortcut: "cp-path"
    	execution: "wl-copy {file}"  # Use xclip -selection clipboard {file} for X11 or pbcopy for macOS
    	leave_broot: false
    }

    # Example 1: launching `tail -n` on the selected file (leaving broot)
    # {
    #     name: tail_lines
    #     invocation: tl {lines_count}
    #     external: "tail -f -n {lines_count} {file}"
    # }

    # Example 2: creating a new file without leaving broot
    # {
    #     name: touch
    #     invocation: touch {new_file}
    #     external: "touch {directory}/{new_file}"
    #     leave_broot: false
    # }

    # Zip selected file(s) into a new archive named <name>.zip
    # This can be called on the staging area after having staged several
    # files or directories
    {
        invocation: "zip {name}"
        external: [
            "zip"
            "-r"
            "{name:path-from-directory}.zip"
            "{file:space-separated}"
        ]
        leave_broot: false
        working_dir: "{root}"
    }

    # A convenient shortcut to create a new text file in
    #  the current directory or below
    {
	invocation: create {subpath}
    	execution: "touch {directory}/{subpath}"
    	leave_broot: false
    }
    {
        invocation: git_diff
        shortcut: gd
        leave_broot: false
        execution: "git difftool -y {file}"
    }

    # Propose the creation of a copy of the selection (`:backup {version}`).
    # This verb demonstrates rare standard groups like {file-stem} and
    # {file-dot-extension} and the auto_exec property, which allows a verb to
    # stay unexecuted until you hit enter. It used to be bound to ctrl-b, but
    # that key now belongs to bcopy (below).
    {
        invocation: "backup {version}"
        leave_broot: false
        auto_exec: false
        execution: "cp -r {file} {parent}/{file-stem}-{version}{file-dot-extension}"
    }

    # By default, `rm` does the system rm, and completely removes
    # the file. If you prefer to have the file moved to the system
    # trash, you may use the ':trash' internal with the verb below:
    # {
    #     invocation: "rm"
    #     internal: "trash"
    #     leave_broot: false
    # }

    # This verb lets you launch a terminal on ctrl-T
    # (on exit you'll be back in broot)
    {
        invocation: terminal
        key: ctrl-t
        execution: "$SHELL"
        set_working_dir: true
        leave_broot: false
    }

    # Scroll the rightest panel on alt-pagedown and alt-pageup,
    # while keeping the focus on your current panel
    {
        key: alt-pagedown
        internal: page_down
        impacted_panel: right
    }
    {
        key: alt-pageup
        internal: page_up
        impacted_panel: right
    }


    # Here's an example of a verb needing the shell capabilities.
    # It copies all children of the currently selected directory
    #  to a destination you type.
    # It uses a star, which needs the shell for expansion. That's
    #  why such verb must have the `from_shell: true` parameter.
    # {
    #     invocation: "cpa {dest}"
    #     external: "cp -r {directory}/* {dest}"
    #     from_shell: true
    # }

    # Piping (`|`) , redirecting (`>`), are also shell features and
    # need the `from_shell: true` parameter.
    # This example pipes the selected file to a running Kakoune session:
    # {
    #     invocation: "to_kak {session}"
    #     external: "echo edit {file} | kak -p {session}"
    #     from_shell: true
    #     leave_broot: false
    # }

    # Here's an example of a shortcut bringing you to your home directory
    # {
    #     invocation: home
    #     key: ctrl-home
    #     execution: ":focus ~"
    # }

    # Here's going to the work-dir root of the current git repository
    # {
    #     invocation: gtr
    #     execution: ":focus {git-root}"
    # }

    # A popular set of shortcuts for going up and down:
    #
    # {
    #     key: ctrl-k
    #     execution: ":line_up"
    # }
    # {
    #     key: ctrl-j
    #     execution: ":line_down"
    # }

    # {
    #     key: ctrl-u
    #     execution: ":page_up"
    # }
    # {
    #     key: ctrl-d
    #     execution: ":page_down"
    # }

    # If you develop using git, you might like to often switch
    # to the git status filter:
    # {
    #     key: alt-g
    #     execution: ":toggle_git_status"
    # }

    # You can reproduce the bindings of Norton Commander
    # on copying or moving to the other panel:
    # {
    #     key: F5
    #     external: "cp -r {file} {other-panel-directory}"
    #     leave_broot: false
    # }
    # {
    #     key: F6
    #     external: "mv {file} {other-panel-directory}"
    #     leave_broot: false
    # }

    # Modal mode: enter input mode with 's' instead of the default '/'.
    # Broot's built-in modal bindings (space, ':', '/') are hard-coded, so the
    # default '/' is unbound first, then 's' is bound to the same internal.
    # A verb with only a `key` and no execution is how a key is unbound.
    # Note: `mode: command` isn't a real verb attribute in broot 1.60.1, and
    # single-character keys are automatically restricted to command mode.
    {
        key: "/"
    }
    {
        key: s
        internal: ":mode_input"
    }

    # ------------------------------------------------------------------
    # Custom keymap (user verbs are matched before broot's builtins).
    # ------------------------------------------------------------------
    # Move the staging toggle off ctrl-g: a verb with only a
    # `key` and no execution unbinds that key everywhere.
    {
        key: ctrl-g
    }
    # ctrl-s stages/unstages the selection.
    # NOTE: broot's builtin `:search_again` (total search) uses ctrl-s; this
    # shadows it. Bind :search_again to another key if you still want it.
    {
        key: ctrl-s
        internal: toggle_stage
    }
    # ctrl-p toggles the staging area panel (open/close).
    # A layout_instructions entry in conf.hjson makes that panel take nearly
    # the whole terminal width when it's open.
    {
        key: ctrl-p
        internal: toggle_staging_area
    }
    # ctrl-l cycles the focus to the next panel on the right, wrapping
    # around. Unlike :panel_right it never opens nor closes a panel, so it
    # can't accidentally close one when you're already on the rightmost.
    # (Open panels with ctrl-p / :toggle_second_tree.)
    {
        key: ctrl-l
        internal: focus_panel_right
    }
    # ctrl-h is `:panel_left`: focus the panel on the left, or open one
    # there (mirror of ctrl-l / ctrl-right).
    {
        key: ctrl-h
        internal: panel_left
    }

    # ------------------------------------------------------------------
    # Interactive zoxide jump: `z` opens zoxide's fzf picker and then tells
    # *this running* broot instance to focus the chosen dir.
    # `z` is a single-character key, so broot automatically makes it
    # command-mode-only (it's inactive while typing in input mode).
    # Works through broot's client-server mode: `--listen-auto` in
    # conf.hjson's default_flags gives each instance a random socket name,
    # which `{server-name}` expands to here. No relaunch, so broot's
    # navigation history and panels are preserved.
    # ------------------------------------------------------------------
    {
        invocation: "zi"
        key: z
        external: [
            "sh"
            "-c"
            "p=$(zoxide query -i) || exit 0; [ -n \"$p\" ] && broot --send {server-name} \"$p\"; exit 0"
        ]
        leave_broot: false
    }

    # ------------------------------------------------------------------
    # Cross-instance copy (`bcopy`, ctrl-b). It copies the ACTIVE panel's
    # selection(s) into another running broot instance's root:
    #  - focus a tree: it copies the current selection (1 file);
    #  - focus the staging area: it copies ALL staged files at once.
    # It deliberately does NOT use `impacted_panel`. The only positional
    # targets broot offers are active/left/right/preview, and a preview panel
    # is always inserted at the far right, so `impacted_panel: right` would
    # grab the previewed file instead of the staged files. Acting on the
    # active panel is immune to preview placement. To send staged files,
    # stage them (ctrl-s), focus the staging area (ctrl-l), then
    # hit ctrl-b.
    # `{file:space-separated}` keeps it a single invocation: one fzf prompt,
    # one copy, one refresh, with every selection passed as its own argument
    # (on the staging area it expands to one argv entry per staged file).
    # Every instance listens (--listen-auto in default_flags), so we discover
    # the others by scanning /tmp/broot-server-*.sock and asking each for its
    # root with `broot --send <name> --get-root`.
    # The "name<TAB>root" candidates are piped to fzf: with several instances
    # you pick one, with a single instance fzf --select-1 picks it silently,
    # and with none (or if you cancel fzf) it's a no-op.
    # Notes:
    #  - the destination is another instance's ROOT (broot exposes no way to
    #    read another instance's cursor).
    # ------------------------------------------------------------------
    {
        invocation: "bcopy"
        key: ctrl-b
        external: [
            "sh"
            "-c"
            "cf=/tmp/broot-bcopy-$$.lst; : > \"$cf\"; for s in $(ls /tmp/broot-server-*.sock 2>/dev/null); do n=$(basename \"$s\" .sock | sed 's/^broot-server-//'); [ \"$n\" = \"{server-name}\" ] && continue; d=$(broot --send \"$n\" --get-root 2>/dev/null) || continue; [ -n \"$d\" ] && printf '%s\\t%s\\n' \"$n\" \"$d\" >> \"$cf\"; done; choice=$(fzf --select-1 --exit-0 --delimiter='\\t' --with-nth='1,2' --prompt='send to broot: ' < \"$cf\"); rm -f \"$cf\"; if [ -n \"$choice\" ]; then dn=$(printf '%s' \"$choice\" | cut -f1); dest=$(printf '%s' \"$choice\" | cut -f2); if [ -n \"$dest\" ] && [ \"$#\" -gt 0 ] && cp -r -- \"$@\" \"$dest\"; then broot --send \"$dn\" -c ':refresh'; fi; fi; exit 0"
            "sh"
            "{file:space-separated}"
        ]
        leave_broot: false
    }
]
